{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${RESOURCE_PRECACHER_VERSION}",
	"name": "ResourcePrecacher",
	"description": "Adds the resources listed in resource_precacher.ini (and in precacher.ini, the utils plugin's list of the Metamod server) to the game session manifest of every map load, so clients download them early. A port of the Metamod:Source plugin 'ResourcePrecacher' by Pisex && komashchenko; the resource files keep their original layout.",
	"author": "Pisex && komashchenko, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/ResourcePrecacher",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
